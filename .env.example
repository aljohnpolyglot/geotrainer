# VITE_GOOGLE_MAPS_API_KEY: browser-restricted key for Maps JavaScript API.
# GOOGLE_MAPS_API_KEY is server-only and belongs in local .env or Supabase secrets, never in VITE_*.
# If API restrictions are enabled on the key, both APIs must be selected there too. Restrict it to your local/deployed HTTP referrers.
VITE_GOOGLE_MAPS_API_KEY=your_browser_key_here

# Supabase project URL and browser-safe publishable key from the project's Connect dialog.
# Never put a Supabase secret key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-only Gemini configuration. By default the local server reads the shared Premiere extension key store.
# GEMINI_API_KEYS=key_one,key_two
# GEMINI_KEYS_FILE=C:\private\gemini-keys.json
# GEMINI_COACH_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash

# Optional same-origin or independent Coach server. Local dev and preview use /api/coach automatically.
# VITE_COACH_ENDPOINT=https://your-coach-server.example/api/coach
